APP_NAME="WorkFlow AI API"
APP_ENVIRONMENT="development"
DEBUG=false

POSTGRES_USER=workflow_ai
POSTGRES_PASSWORD="your_password"
POSTGRES_DB=workflow_ai
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# memory = embed the local corpus at startup; pgvector = query document_chunks
# (run `uv run python -m app.rag.ingest` first).
RAG_RETRIEVER=memory
# Token-aware chunking for the stack-docs corpus (bge-small truncates at 512).
RAG_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=60

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=workflow-ai

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

WORKFLOW_API_TOKEN=
WORKFLOW_EXECUTOR_TOKEN=
WORKFLOW_USER_ID=00000000-0000-4000-8000-000000000001
WORKFLOW_USER_EMAIL=workflow-ai@example.local
